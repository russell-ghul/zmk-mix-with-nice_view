#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 40

/ {
    combos {
        compatible = "zmk,combos";

        boot {
            bindings = <&bootloader>;
            key-positions = <0 11 54 53>;
        };
    };

    behaviors {
        encoder_sc: encoder_sc {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ENCODER_SC";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        LAYER0 {
            display-name = "Defualt";
            bindings = <
&kp ESCAPE      &kp N1        &kp N2        &kp N3           &kp NUMBER_4  &kp N5       &kp NUMBER_6  &kp N7     &kp N8           &kp N9                  &kp N0                   &kp BSPC
&kp TAB         &kp Q         &kp W         &kp E            &kp R         &kp T        &kp Y         &kp U      &kp I            &kp O                   &kp P                    &kp BACKSLASH
&lt 3 CAPSLOCK  &kp A         &kp S         &kp D            &kp F         &kp G        &kp H         &kp J      &kp K            &kp L                   &kp SEMICOLON            &kp SQT
&kp LSHFT       &kp Z         &kp X         &kp C            &kp V         &kp B        &kp N         &kp M      &kp COMMA        &kp DOT                 &kp FSLH                 &kp RSHFT
&kp LCTRL       &kp LEFT_GUI  &kp LEFT_ALT  &lt 1 BACKSPACE  &kp SPACE     &lt 2 ENTER  &lt 2 ENTER   &kp SPACE  &lt 1 BACKSPACE  &mt LEFT_BRACKET MINUS  &mt RIGHT_BRACKET EQUAL  &kp RCTRL
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&encoder_sc SCRL_UP SCRL_DOWN>;
        };

        LAYER1 {
            display-name = "layer 1";
            bindings = <
&kp GRAVE  &trans  &trans   &trans   &trans   &trans  &trans  &trans           &kp KP_DIVIDE    &kp KP_MULTIPLY  &trans        &trans
&trans     &kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS  &trans
&trans     &kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS   &trans
&trans     &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER  &trans
&trans     &trans  &trans   &trans   &trans   &trans  &trans  &trans           &trans           &kp KP_NUMBER_0  &kp KP_DOT    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        LAYER2 {
            display-name = "layer 2";
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR     &kp PERCENT  &kp CARET  &kp AMPERSAND  &kp ASTERISK   &kp LEFT_PARENTHESIS            &kp RIGHT_PARENTHESIS            &trans
&trans     &trans           &kp HOME     &kp UP    &kp PAGE_UP    &trans       &trans     &trans         &trans         &trans                          &trans                           &kp PIPE
&trans     &trans           &kp LEFT     &kp DOWN  &kp RIGHT      &trans       &trans     &trans         &trans         &trans                          &kp COLON                        &kp DOUBLE_QUOTES
&trans     &trans           &kp END      &trans    &kp PAGE_DOWN  &trans       &trans     &trans         &kp LESS_THAN  &kp GREATER_THAN                &kp QUESTION                     &trans
&trans     &trans           &trans       &trans    &trans         &trans       &trans     &trans         &trans         &mt LS(LEFT_BRACKET) LS(MINUS)  &mt LS(RIGHT_BRACKET) LS(EQUAL)  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp UP_ARROW DOWN>;
        };

        LAYER3 {
            display-name = "Buleth";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2          &bt BT_SEL 3  &bt BT_SEL 4     &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC  &trans        &trans           &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &kp C_MUTE         &kp LG(D)             &trans        &kp PRINTSCREEN  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC  &trans        &kp DELETE       &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans             &trans                &trans        &trans           &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };
    };
};
